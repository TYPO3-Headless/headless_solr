@import './ContentElements/*.typoscript'

plugin.tx_solr {
  settings {
    searchPid = {$plugin.tx_solr.settings.searchPid}
  }
}

lib.tx_solr.sys_category_title = RECORDS
lib.tx_solr.sys_category_title {
  source.current = 1
  tables = sys_category
  dontCheckPid = 1
  conf {
    sys_category = TEXT
    sys_category.field = title
    sys_category.htmlSpecialChars = 1
  }
}
